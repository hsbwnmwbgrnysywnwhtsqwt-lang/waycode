{
  "name": "waycode",
  "displayName": "WayCode",
  "description": "Professional AI coding agent for VS Code — understands natural language (including Hebrew), whole projects, writes and edits code, runs tests, and fixes itself.",
  "version": "1.0.0",
  "publisher": "tools-mishmish",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hsbwnmwbgrnysywnwhtsqwt-lang/waycode.git"
  },
  "bugs": {
    "url": "https://github.com/hsbwnmwbgrnysywnwhtsqwt-lang/waycode/issues"
  },
  "homepage": "https://github.com/hsbwnmwbgrnysywnwhtsqwt-lang/waycode#readme",
  "icon": "media/logo.png",
  "galleryBanner": {
    "color": "#1A1A20",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Machine Learning"
  ],
  "keywords": [
    "ai",
    "agent",
    "copilot",
    "assistant",
    "openai",
    "anthropic",
    "ollama"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "waycode",
          "title": "WayCode",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "waycode": [
        {
          "type": "webview",
          "id": "waycode.chatView",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "waycode.openChat",
        "title": "WayCode: Open Chat",
        "category": "WayCode"
      },
      {
        "command": "waycode.openPanel",
        "title": "WayCode: Open in Editor Tab",
        "category": "WayCode",
        "icon": "media/icon.svg"
      },
      {
        "command": "waycode.openSettings",
        "title": "WayCode: Settings",
        "category": "WayCode",
        "icon": "$(gear)"
      },
      {
        "command": "waycode.newTask",
        "title": "WayCode: New Task",
        "category": "WayCode"
      },
      {
        "command": "waycode.addFileToContext",
        "title": "WayCode: Add File to Context",
        "category": "WayCode"
      },
      {
        "command": "waycode.selectModel",
        "title": "WayCode: Select Model / Provider",
        "category": "WayCode"
      },
      {
        "command": "waycode.setApiKey",
        "title": "WayCode: Set API Key",
        "category": "WayCode"
      },
      {
        "command": "waycode.configureRoles",
        "title": "WayCode: Configure Agent Roles (Communicator / Coder)",
        "category": "WayCode"
      },
      {
        "command": "waycode.setApprovalMode",
        "title": "WayCode: Set Approval Mode",
        "category": "WayCode"
      },
      {
        "command": "waycode.selectLanguage",
        "title": "WayCode: Select Response Language",
        "category": "WayCode"
      },
      {
        "command": "waycode.askSelection",
        "title": "WayCode: Ask About Selection",
        "category": "WayCode"
      },
      {
        "command": "waycode.history",
        "title": "WayCode: Conversation History",
        "category": "WayCode",
        "icon": "$(history)"
      },
      {
        "command": "waycode.editContext",
        "title": "WayCode: Edit Project Context File",
        "category": "WayCode"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "waycode.addFileToContext",
          "group": "waycode"
        }
      ],
      "editor/context": [
        {
          "command": "waycode.askSelection",
          "group": "waycode",
          "when": "editorHasSelection"
        }
      ],
      "view/title": [
        {
          "command": "waycode.openSettings",
          "when": "view == waycode.chatView",
          "group": "navigation@1"
        },
        {
          "command": "waycode.openPanel",
          "when": "view == waycode.chatView",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "waycode.openPanel",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "WayCode",
      "properties": {
        "waycode.provider": {
          "type": "string",
          "enum": [
            "anthropic",
            "openai",
            "ollama",
            "claude-cli"
          ],
          "enumDescriptions": [
            "Anthropic API (key)",
            "OpenAI API (key)",
            "Local Ollama (no key)",
            "Claude Code CLI — uses your Claude subscription, no key"
          ],
          "default": "anthropic",
          "description": "Active AI provider."
        },
        "waycode.model": {
          "type": "string",
          "default": "claude-sonnet-4-5",
          "description": "Model id for the active provider (e.g. claude-sonnet-4-5, gpt-4o, gemma2, llama3.1)."
        },
        "waycode.ollama.baseUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Base URL for a local Ollama server."
        },
        "waycode.openai.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Optional base URL for an OpenAI-compatible endpoint (e.g. LM Studio, Groq, Together, Azure). Leave empty for api.openai.com."
        },
        "waycode.language": {
          "type": "string",
          "default": "auto",
          "enum": ["auto", "Hebrew", "English", "Arabic", "Russian", "Spanish", "French", "German", "Portuguese", "Chinese"],
          "description": "Language the assistant replies in. 'auto' matches the language you write in."
        },
        "waycode.maxAgentSteps": {
          "type": "number",
          "default": 25,
          "description": "Maximum number of tool-use iterations the agent may take for a single task."
        },
        "waycode.autoApproveReads": {
          "type": "boolean",
          "default": true,
          "description": "Auto-approve read-only tools (reading/listing/searching files)."
        },
        "waycode.autoApprove.fileEdits": {
          "type": "boolean",
          "default": false,
          "description": "Auto-approve file writes/edits/creates without asking. Turn on only if you trust the agent to change files freely."
        },
        "waycode.autoApprove.commands": {
          "type": "boolean",
          "default": false,
          "description": "Auto-approve terminal, git, test and lint commands without asking. Use with caution."
        },
        "waycode.multiAgent.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable the multi-agent pipeline: a language/communication bot understands you (e.g. in Hebrew) and explains results, while a separate coder bot writes the code. When off, a single agent handles everything."
        },
        "waycode.roles.communicator.provider": {
          "type": "string",
          "enum": ["", "anthropic", "openai", "ollama", "claude-cli"],
          "enumDescriptions": ["Use the default provider (waycode.provider)", "Anthropic", "OpenAI", "Ollama", "Claude Code CLI (no key)"],
          "default": "ollama",
          "description": "Provider for the COMMUNICATOR role (understands the user and explains results). Empty = use waycode.provider. Defaults to a local Ollama model so the personal assistant runs entirely on your machine."
        },
        "waycode.roles.communicator.model": {
          "type": "string",
          "default": "gemma2",
          "description": "Model id for the communicator role. Pick a model strong at natural language (e.g. Hebrew) — the local Ollama model gemma2 (or gemma2:9b) works well and runs on your machine."
        },
        "waycode.roles.coder.provider": {
          "type": "string",
          "enum": ["", "anthropic", "openai", "ollama", "claude-cli"],
          "enumDescriptions": ["Use the default provider (waycode.provider)", "Anthropic", "OpenAI", "Ollama", "Claude Code CLI (no key)"],
          "default": "",
          "description": "Provider for the CODER role (writes/edits code). Empty = use waycode.provider."
        },
        "waycode.roles.coder.model": {
          "type": "string",
          "default": "",
          "description": "Model id for the coder role. Empty = the provider's default model. Pick a model strong at code (e.g. qwen2.5-coder), it need not speak your language."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "typecheck": "tsc --noEmit -p ./",
    "pretest": "tsc -p ./",
    "test": "node --test out/test/"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
